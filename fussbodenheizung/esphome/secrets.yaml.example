# Nach secrets.yaml kopieren und ausfüllen (secrets.yaml NICHT ins Git!).
# Im ESPHome-Add-on von Home Assistant liegt secrets.yaml unter /config/esphome/.
wifi_ssid: "MeinWLAN"
wifi_passwort: "geheim"
fallback_passwort: "mindestens8zeichen"
# API-Schlüssel: 32 Byte Base64, z.B. erzeugen mit
#   python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
api_key_zentrale: "BASE64-SCHLUESSEL-ZENTRALE="
api_key_sensoren: "BASE64-SCHLUESSEL-SENSOREN="
# Gemeinsamer Schlüssel für die UDP-Übertragung Raumsensor -> Zentrale
transport_key: "langes-zufaelliges-passwort-fuer-udp"
